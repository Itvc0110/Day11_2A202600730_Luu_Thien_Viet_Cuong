# Day 11 Guardrails / HITL local environment
#
# Copy this file to .env for local use. Do not commit real API keys.

# Primary LLM provider for the local Python implementation.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional compatibility variable for code paths that still import Google ADK/GenAI.
# If omitted, src/core/config.py mirrors OPENROUTER_API_KEY into GOOGLE_API_KEY.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0

# Optional metadata sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_TITLE=Day 11 Guardrails VinBank
